{
    "layer": "top",
    "position": "top",
    "height": 38,
    "modules-left": [
        "custom/menu",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "custom/prev",
        "mpris",
        "custom/play-pause",
        "custom/next",
        "clock"
    ],
    "modules-right": [
        "tray",
        "custom/volume",
        "cpu",
        "memory",
        "temperature",
        "network",
        "custom/weather",
        "custom/power"
    ],
    "custom/menu": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "hyprctl dispatch togglespecialworkspace magic"
    },
    "hyprland/workspaces": {
        "format": "●",
        "on-click": "activate"
    },
    "custom/prev": {
        "format": "󰒮",
        "tooltip": false,
        "on-click": "playerctl --player=spotify previous"
    },
    "mpris": {
        "format": "{dynamic}",
        "format-playing": "󰎆 {artist} - {title}",
        "format-paused": "󰏤 Pausado",
        "max-length": 35,
        "player": "spotify"
    },
    "custom/play-pause": {
        "format": "{}",
        "exec": "playerctl --player=spotify status 2>/dev/null | grep -q Playing && echo '󰏤' || echo '󰐊'",
        "interval": 1,
        "tooltip": false,
        "on-click": "playerctl --player=spotify play-pause"
    },
    "custom/next": {
        "format": "󰒭",
        "tooltip": false,
        "on-click": "playerctl --player=spotify next"
    },
    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃭 {:%d/%m/%Y}",
        "tooltip-format": "<big>{:%A %d %B %Y}</big>"
    },
    "cpu": {
        "format": "   {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "  {percentage}%",
        "interval": 2
    },
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "format": " 󰿸 {temperatureC}°C",
        "critical-threshold": 80,
        "format-critical": " {temperatureC}°C"
    },
    "network": {
        "format-wifi": "󰤨 {signalStrength}%",
        "format-ethernet": "󰈀 Conectado",
        "format-disconnected": "󰤮 Sin red",
        "tooltip-format": "{ifname}: {ipaddr}"
    },
    "group/tray": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "children-class": "tray-item",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/taskbar-arrow",
            "tray"
        ]
    },
    "tray": {
        "spacing": 8
    },
    "custom/weather": {
        "format": "{}",
        "exec": "~/.config/hypr/scripts/weather.sh",
        "interval": 3600,
        "tooltip": false
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "wlogout --layout ~/.config/hypr/wlogout/layout --css ~/.config/hypr/wlogout/style.css"
    },
    "custom/volume": {
        "format": "󰕾",
        "tooltip": false,
        "on-click": "pavucontrol"
    }
}